# Copy this file to server/.env and fill in whichever providers you use.
# Keys set here stay on the server and never reach the browser. You can also
# type a key into the IDE's Settings panel instead — that one wins if present.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- optional ---------------------------------------------------------------

# PORT=4400
# HOST=127.0.0.1

# Sandbox root. Everything the terminal and the agent can touch lives here.
# WORKSPACE_ROOT=./workspace

# OpenAI-compatible endpoints (DeepSeek, Groq, OpenRouter, Ollama, ...)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Agent behaviour
# AGENT_MAX_ITERATIONS=24
# AGENT_MAX_TOKENS=32000
# AGENT_EFFORT=high          # low | medium | high | xhigh | max (Claude only)
# AGENT_ALLOW_BASH=true      # set false to take run_command away from the agent
# ANTHROPIC_FALLBACKS=default  # set to "off" to disable server-side refusal fallbacks

# Shell used by the terminal and run_command
# SHELL_BIN=powershell.exe
